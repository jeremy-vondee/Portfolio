---
import "../styles/global.css"
import Layout from "@/Layout/Layout.astro"
import Header from "@/components/Header"
import { Button } from "@/components/ui/button"
import { HugeiconsIcon } from "@hugeicons/react"
import {
    WhatsappIcon,
    TwitterIcon,
    InstagramIcon,
    GithubIcon,
    Email,
} from "@hugeicons/core-free-icons"
import Particles from "@/components/Particles"
---

<Layout title="Juinor UI/UX Designer & Frontend Developer Portfolio">
    <Header client:load />
    <Particles
        client:load
        particleCount={230}
        particleSpread={8}
        speed={0.11}
        particleColors={["#0a3d9e"]}
        moveParticlesOnHover={false}
        alphaParticles={false}
        particleBaseSize={100}
        sizeRandomness={1}
        cameraDistance={10}
        disableRotation={true}
    />

    <section class="mx-auto max-w-6xl px-4 pt-24 sm:pt-32 md:pt-40 lg:pt-48">
        <div class="text-center md:text-left">
            <div
                class="flex items-center justify-center md:justify-start gap-2 mb-2">
                <h6
                    class="font-extralight text-sm sm:text-base md:text-lg lg:text-xl">
                    Hi, there! I'm Jeremy
                </h6>
                <img
                    src="/waving-hand.svg"
                    class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6"
                    alt="waving hand icon"
                />
            </div>

            <h2
                class="font-bold text-2xl sm:text-3xl md:text-5xl lg:text-6xl mt-3 leading-tight">
                I'm a Junior UI/UX Designer <br />& Frontend Developer
            </h2>

            <h3
                class="text-base sm:text-lg md:text-xl mt-5 max-w-2xl mx-auto md:mx-0">
                I bridge design and development, turning user needs into clean,
                <br class="hidden sm:block" />
                interactive interfaces.
            </h3>

            <div
                class="mt-6 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                <a href="#projects" class="cursor-pointer">
                    <Button
                        variant="link"
                        type="button"
                        className="cursor-pointer bg-primary text-white p-5 rounded-sm hover:no-underline focus:ring-0 focus:outline-none">
                        View My Work
                    </Button>
                </a>

                <a
                    href="/jeremy-resume.pdf"
                    download="Jeremy-resume.pdf"
                    class="cursor-pointer">
                    <Button
                        variant="outline"
                        type="button"
                        className="cursor-pointer text-primary border-primary p-5 rounded-sm hover:text-primary focus:ring-0 focus:outline-none focus:border-0">
                        View My Resume
                    </Button>
                </a>
            </div>
        </div>
    </section>
    <section
        id="about"
        class="mx-auto max-w-6xl px-4 py-20 sm:py-28 md:py-36 lg:py-44">
        <div class="text-center mb-8 sm:mb-10">
            <h2
                class="font-bold font-mono inline-block border-b-2 border-black pb-2 text-2xl sm:text-3xl">
                About Me
            </h2>
        </div>
    </section>

    <section
        id="projects"
        class="mx-auto max-w-6xl px-4 py-20 sm:py-28 md:py-36 lg:py-44">
        <div class="text-center mb-8 sm:mb-10">
            <h2
                class="font-bold font-mono inline-block border-b-2 border-black pb-2 text-2xl sm:text-3xl">
                Projects
            </h2>
        </div>
    </section>

    <section
        id="contacts"
        class="mx-auto max-w-6xl px-4 py-20 sm:py-28 md:py-36 lg:py-44">
        <div class="text-center mb-8 sm:mb-10">
            <h2
                class="font-bold font-mono inline-block border-b-2 border-black pb-2 text-2xl sm:text-3xl">
                Contacts
            </h2>
        </div>
        <div class="flex justify-around">
            <a
                href="https://wa.me/15551234567"
                target="_blank"
                rel="noreferrer">
                <div class="flex content-center items-center flex-col gap-4">
                    <HugeiconsIcon
                        icon={WhatsappIcon}
                        className="size-5 sm:size-6 md:size-7 lg:size-8"
                        color="currentColor"
                        strokeWidth={1.5}
                    />
                    <span class="hidden md:block text-sm md:text-base"
                        >Whatsapp</span
                    >
                </div>
            </a>
            <a href="https://wa.me/15551234567">
                <div class="flex content-center items-center flex-col gap-4">
                    <HugeiconsIcon
                        icon={InstagramIcon}
                        className="size-5 sm:size-6 md:size-7 lg:size-8"
                        color="currentColor"
                        strokeWidth={1.5}
                    />
                    <span class="hidden md:block text-sm md:text-base"
                        >Instagram</span
                    >
                </div>
            </a>
            <a href="https://wa.me/15551234567">
                <div class="flex content-center items-center flex-col gap-4">
                    <HugeiconsIcon
                        icon={TwitterIcon}
                        className="size-5 sm:size-6 md:size-7 lg:size-8"
                        color="currentColor"
                        strokeWidth={1.5}
                    />
                    <span class="hidden md:block text-sm md:text-base">X</span>
                </div>
            </a>
            <a href="https://github.com/jeremy-vondee">
                <div class="flex content-center items-center flex-col gap-4">
                    <HugeiconsIcon
                        icon={GithubIcon}
                        className="size-5 sm:size-6 md:size-7 lg:size-8"
                        color="currentColor"
                        strokeWidth={1.5}
                    />
                    <span class="hidden md:block text-sm md:text-base"
                        >Github</span
                    >
                </div>
            </a>
            <a href="mailto:jeremynarteyodonkor@gmail.com">
                <div class="flex content-center items-center flex-col gap-4">
                    <HugeiconsIcon
                        icon={Email}
                        className="size-5 sm:size-6 md:size-7 lg:size-8"
                        color="currentColor"
                        strokeWidth={1.5}
                    />
                    <span class="hidden md:block text-sm md:text-base"
                        >Gmail</span
                    >
                </div>
            </a>
        </div>
    </section>
</Layout>
